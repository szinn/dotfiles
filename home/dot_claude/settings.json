  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/tokensave hook-pre-tool-use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/tokensave hook-stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/tokensave hook-prompt-submit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "issueboss@issueboss-marketplace": true,
    "llm-wiki@llm-wiki-marketplace": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "issueboss-marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/scotte/Development/Projects/IssueBoss"
      }
    },
    "llm-wiki-marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/scotte/Development/Projects/llm-wiki"
      }
    }
  },
  "outputStyle": "Concise",
  "skipWebFetchPreflight": true,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "autoMode": {
