# starship setup
# Requires `brew install starship`
if status --is-interactive
    if test "$TERM" = dumb
        set -gx PS1 '$ '
        function fish_prompt
            echo -n '$ '
        end
    else if type -q starship
        set -gx STARSHIP_CONFIG "$XDG_CONFIG_HOME/starship/starship.toml"
        starship init fish | source
    end
end
